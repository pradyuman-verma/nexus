# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://nexus:password@localhost:5432/nexus

# ── Chat models (Tiers 2/4/5) ────────────────────────────
# IMPORTANT: this file is read by systemd's EnvironmentFile, which does NOT strip
# trailing "# comments" — keep comments on their own lines, never after a value.
#
# Each tier is served by "anthropic" (Claude) or "ollama" (local).
ANTHROPIC_API_KEY=
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-4-6

# Tier 2 (summarize + relevance excerpt) — local Ollama, high volume.
TIER2_PROVIDER=ollama
# Tier 4 (entity/edge extraction) — Claude, needs reasoning.
GRAPH_PROVIDER=anthropic
# Tier 5 (/ask synthesis) — Claude, interactive latency.
RAG_PROVIDER=anthropic

# OpenAI-compatible chat endpoint, used by any *_PROVIDER set to "ollama".
# Despite the name these knobs accept ANY OpenAI-compatible chat API:
#
#   Local Ollama (free, slow on CPU):
#     OLLAMA_BASE_URL=http://localhost:11434/v1
#     OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct   (or 7b for better quality, slower)
#     OLLAMA_API_KEY=                          (leave blank)
#
#   Groq (hosted OSS — very fast, ~$0.59/M, great for /ask without a GPU):
#     OLLAMA_BASE_URL=https://api.groq.com/openai/v1
#     OLLAMA_CHAT_MODEL=llama-3.3-70b-versatile
#     OLLAMA_API_KEY=gsk_...
#
#   DeepSeek (hosted OSS — very cheap, ~$0.28/M, strong quality):
#     OLLAMA_BASE_URL=https://api.deepseek.com/v1
#     OLLAMA_CHAT_MODEL=deepseek-chat
#     OLLAMA_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_API_KEY=

# ── Preset: FULLY LOCAL (no Claude, zero API spend) ──────
# GPU ONLY — do not use on a CPU box (32B on CPU answers /ask in minutes).
# On a GPU (≈24GB+ VRAM): uncomment below + `ollama pull qwen2.5:32b-instruct`.
# Every tier routed to ollama shares OLLAMA_CHAT_MODEL, so all chat tiers run 32B.
# GRAPH_PROVIDER=ollama
# RAG_PROVIDER=ollama
# OLLAMA_CHAT_MODEL=qwen2.5:32b-instruct
# ANTHROPIC_API_KEY=          # not needed once all tiers are local

# ── Embeddings (Tier 3) ──────────────────────────────────
# Local, on Ollama. EMBEDDING_DIM must match the model. The vector columns are
# created at this dimension on first boot — changing it later needs a fresh DB.
#
#   mxbai-embed-large    → 1024  (default; strong retrieval, GPU-friendly)
#   bge-m3               → 1024  (multilingual alternative)
#   nomic-embed-text     → 768   (lighter, CPU-friendly)
#   text-embedding-3-small (OpenAI) → 1536
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=http://localhost:11434/v1/embeddings
# For a hosted provider (OpenAI/Voyage) set the URL above to their endpoint
# and provide a key here (or reuse OPENAI_API_KEY):
EMBEDDING_API_KEY=
# OPENAI_API_KEY=

# ── Ingestion ────────────────────────────────────────────
# Path to the yt-dlp binary used to fetch YouTube transcripts. install.sh puts
# it at /usr/local/bin/yt-dlp; "yt-dlp" works if it's on PATH. If yt-dlp is
# missing, YouTube links degrade to a description-only stub (no crash).
YTDLP_PATH=yt-dlp

# ── Behaviour ────────────────────────────────────────────
RUST_LOG=nexus=info,sqlx=warn
CONTEXT_WINDOW_WAIT_SECS=60
INGESTION_BATCH_SIZE=20
GRAPH_CRON_SCHEDULE=0 0 */6 * * *
CLEANUP_CRON_SCHEDULE=0 0 0 * * *
HEALTH_CRON_SCHEDULE=0 */15 * * * *
DEFAULT_RELEVANCE_THRESHOLD=0.72
MAX_VECTOR_WEIGHT=100.0
NOTIFICATION_SCORE_LOG=true
URL_DEDUP_DAYS=7
